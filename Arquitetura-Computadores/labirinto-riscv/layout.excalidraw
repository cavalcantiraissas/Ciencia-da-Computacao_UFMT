   "link": null,
   "locked": false,
   "text": "Corredor em serpentina (carve_path):\n1. linha 1, colunas 1 a 28  (->)\n2. coluna 29, linhas 1 a 6  (v)\n3. linha 7, colunas 29 a 2  (<-)\n4. coluna 1, linhas 7 a 12  (v)\n5. linha 13, colunas 1 a 28 (->)\n6. coluna 29, linhas 13 a 18 (v)\n7. linha 19, colunas 29 a 2 (<-)\n\nPixel = 0xC00 + linha * 32 + coluna\nControles: W A S D",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 16,
   "containerId": null,
   "originalText": "Corredor em serpentina (carve_path):\n1. linha 1, colunas 1 a 28  (->)\n2. coluna 29, linhas 1 a 6  (v)\n3. linha 7, colunas 29 a 2  (<-)\n4. coluna 1, linhas 7 a 12  (v)\n5. linha 13, colunas 1 a 28 (->)\n6. coluna 29, linhas 13 a 18 (v)\n7. linha 19, colunas 29 a 2 (<-)\n\nPixel = 0xC00 + linha * 32 + coluna\nControles: W A S D",
   "lineHeight": 1.25,
   "autoResize": true
  }
